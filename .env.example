# Copie este archivo como .env y ajuste los valores de su equipo.
# El archivo .env NO se sube al repositorio (está en .gitignore).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=paralelo108_energia

# Clave para firmar los mensajes de la aplicación: cámbiela por un texto largo y aleatorio.
SECRET_KEY=cambie-esta-clave

# Usuario que queda como "registrado_por" mientras no exista inicio de sesión (HU-05).
APP_USUARIO_ID=1

# 1 = modo depuración (solo en desarrollo). 0 = desactivado.
FLASK_DEBUG=0
APP_PORT=5000

# Base de datos que usan las pruebas automáticas (se borra y se recrea en cada prueba).
TEST_DB_NAME=paralelo108_test
